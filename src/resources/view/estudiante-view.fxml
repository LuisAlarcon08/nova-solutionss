<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" styleClass="main-pane" stylesheets="@../css/estudiante-view.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.edu.enriques.nova.solutionss.controller.EstudianteController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Título -->
    <Label styleClass="title-label" text="Gestión de Estudiantes" />

    <!-- Formulario de entrada -->
    <HBox spacing="10.0">
        <VBox HBox.hgrow="ALWAYS">
            <Label styleClass="form-label" text="Carnet:" />
            <TextField fx:id="txtCarnet" promptText="Ej. 2023289" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS">
            <Label styleClass="form-label" text="Nombres:" />
            <TextField fx:id="txtNombres" promptText="Nombres" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS">
            <Label styleClass="form-label" text="Apellidos:" />
            <TextField fx:id="txtApellidos" promptText="Apellidos" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS">
            <Label styleClass="form-label" text="Grado:" />
            <TextField fx:id="txtGrado" promptText="Ej. 4to Informática" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS">
            <Label styleClass="form-label" text="Sección:" />
            <TextField fx:id="txtSeccion" promptText="Ej. A" />
        </VBox>
    </HBox>

    <!-- Botones de Acción -->
    <HBox spacing="10.0">
        <Button fx:id="btnGuardar" onAction="#handleGuardarEstudiante" styleClass="btn-success" text="Guardar" />
        <Button fx:id="btnEliminar" onAction="#handleEliminarEstudiante" styleClass="btn-danger" text="Eliminar" />
        <Button fx:id="btnLimpiar" onAction="#handleLimpiarCampos" styleClass="btn-secondary" text="Limpiar" />
        <Button fx:id="btnVolver" onAction="#handleVolverMenu" styleClass="btn-primary" text="Volver al Menú" />
    </HBox>

    <!-- Campo de búsqueda -->
    <TextField fx:id="txtBuscar" promptText="🔍 Buscar por Carnet, Nombre o Apellido..." />

    <!-- Tabla de datos -->
    <TableView fx:id="tblEstudiantes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
            <TableColumn fx:id="colCarnet" prefWidth="120.0" text="Carnet" />
            <TableColumn fx:id="colNombres" prefWidth="180.0" text="Nombres" />
            <TableColumn fx:id="colApellidos" prefWidth="180.0" text="Apellidos" />
            <TableColumn fx:id="colGrado" prefWidth="150.0" text="Grado" />
            <TableColumn fx:id="colSeccion" prefWidth="80.0" text="Sección" />
        </columns>
    </TableView>
</VBox>