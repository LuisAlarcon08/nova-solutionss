<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.edu.enriques.nova.solutionss.controller.DashboardController">
    <stylesheets>
        <URL value="@/resources/css/dashboard-view.css" />
    </stylesheets>
    <children>
        <VBox alignment="CENTER" spacing="25.0" stylesheets="@../css/dashboard-view.css" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="40.0">
            <children>
                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Panel Principal - Nova Solutions" />
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Selecciona el módulo al que deseas acceder" />
                    </children>
                </VBox>

                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleIrAEstudiantes" prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 8;" text="Gestión de&#10;Estudiantes" textAlignment="CENTER" />
                        <Button mnemonicParsing="false" onAction="#handleCerrarSesion" prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 8;" text="Cerrar Sesión" textAlignment="CENTER" />
                    </children>
                </HBox>
            </children>
         <styleClass>
            <String fx:value="dashboard-root" />
            <String fx:value="dashboard-title" />
            <String fx:value="dashboard-subtitle" />
            <String fx:value="card-button" />
            <String fx:value="card-icon" />
         </styleClass>
        </VBox>
    </children>
</AnchorPane>
