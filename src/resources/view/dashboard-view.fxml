<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="25.0" styleClass="main-pane" stylesheets="@../css/dashboard-view.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.edu.enriques.nova.solutionss.controller.DashboardController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <!-- Header / Título -->
    <VBox alignment="CENTER" spacing="8.0">
        <Label styleClass="title-label" text="Panel Principal - Nova Solutions" />
        <Label styleClass="subtitle-label" text="Selecciona el módulo al que deseas acceder" />
    </VBox>

    <!-- Contenedor de Botones de Menú -->
    <HBox alignment="CENTER" spacing="20.0">
        <Button fx:id="btnGestionEstudiantes" onAction="#handleGestionEstudiantes" prefHeight="100.0" prefWidth="200.0" styleClass="btn-dashboard-primary" text="Gestión de Estudiantes" textAlignment="CENTER" wrapText="true" />
        <Button fx:id="btnCerrarSesion" onAction="#handleCerrarSesion" prefHeight="100.0" prefWidth="200.0" styleClass="btn-dashboard-danger" text="Cerrar Sesión" textAlignment="CENTER" wrapText="true" />
    </HBox>
</VBox>
