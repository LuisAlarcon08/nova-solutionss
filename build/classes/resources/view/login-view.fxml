<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="700.0" prefWidth="900.0" styleClass="root-pane" stylesheets="@/resources/css/login-view.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.edu.enriques.nova.solutionss.controller.LoginController">
    <children>
        <VBox alignment="CENTER" spacing="20.0" stylesheets="@../css/login-view.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <!-- Título principal -->
                <Label styleClass="form-title" text="Sign in to Nova Solutions" />

                <!-- Formulario -->
                <VBox maxWidth="350.0" prefWidth="350.0" spacing="15.0" styleClass="login-box">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label styleClass="field-label" text="Usuario" />
                                <TextField fx:id="txtUsuario" promptText="Username or email address" styleClass="github-field" />
                            </children>
                        </VBox>

                        <VBox spacing="5.0">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label styleClass="field-label" text="Contraseña" HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                                <PasswordField fx:id="txtPassword" styleClass="github-field" />
                            </children>
                        </VBox>
                        
                        <Button fx:id="btnIniciar" mnemonicParsing="false" onAction="#handleLogin" prefWidth="350.0" styleClass="btn-github-green" text="Sign in" />
                    </children>
                </VBox>

                <!-- Registro -->
                <VBox alignment="CENTER" maxWidth="350.0" prefWidth="350.0" styleClass="signup-box" />
            </children>
         <styleClass>
            <String fx:value="root-pane" />
            <String fx:value="forgot-link" />
            <String fx:value="signup-link" />
            <String fx:value="root-pane" />
            <String fx:value="signup-text" />
            <String fx:value="mainFxmlClass" />
            <String fx:value="forgot-link" />
         </styleClass>
        </VBox>
    </children>
</AnchorPane>
